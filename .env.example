# Database. Generate a unique long password before deployment.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Security. Generate OWNER_SETUP_TOKEN once, use it to create the first owner, then remove/rotate it.
OWNER_SETUP_TOKEN=replace-with-a-long-random-setup-code
# Set COOKIE_SECURE=true once the app is served over HTTPS/Tailscale HTTPS.
SESSION_DAYS=14
COOKIE_SECURE=false
HSTS_ENABLED=false
MAX_UPLOAD_MB=100

# Background research cadence. Minimum enforced by the app is 15 minutes.
RESEARCH_INTERVAL_MINUTES=180

# Optional OpenAI-compatible endpoint. Leave blank to use the built-in deterministic starter generator.
# For Ollama on the same private Docker network, point this at the Ollama service.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
